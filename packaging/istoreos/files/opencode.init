#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -r /etc/opencode/service.conf ] || return 1
    . /etc/opencode/service.conf
    [ -x "$OPENCODE_DATA/bin/opencode" ] && [ -d "$OPENCODE_DATA/workspace" ] || return 1
    [ -n "$OPENCODE_SERVER_PASSWORD" ] || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/opencode-run "$OPENCODE_DATA" "$OPENCODE_BIND" "$OPENCODE_PORT"
    procd_set_param user opencode
    procd_set_param group opencode
    procd_set_param no_new_privs 1
    procd_set_param env "HOME=$OPENCODE_DATA/home" \
        "XDG_DATA_HOME=$OPENCODE_DATA/state/share" \
        "XDG_CONFIG_HOME=$OPENCODE_DATA/state/config" \
        "XDG_CACHE_HOME=$OPENCODE_DATA/state/cache" \
        "OPENCODE_SERVER_USERNAME=opencode" \
        "OPENCODE_SERVER_PASSWORD=$OPENCODE_SERVER_PASSWORD"
    procd_set_param file /etc/opencode/service.conf
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_interface_trigger "interface.*.up" "lan" /etc/init.d/opencode restart
    # Retry when the persistent data disk is mounted after service startup.
    [ -r /etc/opencode/service.conf ] || return 0
    . /etc/opencode/service.conf
    procd_add_restart_mount_trigger "$OPENCODE_DATA"
}
